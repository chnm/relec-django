# Religious Ecologies development environment
# Copy this file to .env and replace placeholder values as needed.

# Django
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1:8000
DJANGO_READ_DOT_ENV_FILE=True

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=religious_ecologies
DB_USER=religious_ecologies
DB_PASS=password

# Cache (leave blank to use Django's in-process development cache)
MEMCACHED_URL=

# Object storage (leave disabled to store media in local mediafiles/)
OBJ_STORAGE=False
OBJ_STORAGE_ACCESS_KEY_ID=
OBJ_STORAGE_SECRET_ACCESS_KEY=
OBJ_STORAGE_BUCKET_NAME=
OBJ_STORAGE_ENDPOINT_URL=

# Claude transcription runs
# Keep disabled until an API key and the separate transcription worker are ready.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
CLAUDE_TRANSCRIPTION_ENABLED=False

# Optional Git commit, image digest, or release identifier. When deployment
# automation supplies it, the value is copied into immutable run provenance.
APPLICATION_REVISION=

# Comma-separated allowlist shown in the admin run form.
CLAUDE_TRANSCRIPTION_MODELS=claude-sonnet-4-6,claude-sonnet-5

# Maximum generated tokens for each schedule request.
CLAUDE_TRANSCRIPTION_MAX_TOKENS=4096

# Large-run confirmation threshold and emergency per-run job-count ceiling.
# Leave the optional Pilot size blank in admin to queue the full ready selection.
CLAUDE_TRANSCRIPTION_LARGE_RUN_THRESHOLD=100
CLAUDE_TRANSCRIPTION_MAX_RUN_JOBS=10000

# Provider batch limits. Only this many batches can be active concurrently.
CLAUDE_TRANSCRIPTION_BATCH_SIZE=25
CLAUDE_TRANSCRIPTION_MAX_ACTIVE_BATCHES=1
CLAUDE_TRANSCRIPTION_MAX_BATCH_BYTES=209715200

# Maximum base64-encoded image size (10 MiB for the direct Claude API).
CLAUDE_TRANSCRIPTION_MAX_IMAGE_BYTES=10485760

# Restart/recovery leases and provider polling behavior, in seconds.
CLAUDE_TRANSCRIPTION_LEASE_SECONDS=300
CLAUDE_TRANSCRIPTION_POLL_SECONDS=60
CLAUDE_TRANSCRIPTION_REQUEST_TIMEOUT=120

# Optional override for the validated Batch pricing catalog. If omitted, the
# application uses its version-controlled Claude Sonnet pricing catalog. Rates
# are USD per million tokens and are frozen into each immutable run.
CLAUDE_TRANSCRIPTION_PRICING={"schema_version":1,"currency":"USD","unit":"per_million_tokens","service_tier":"batch","effective_date":"2026-08-11","source":"https://platform.claude.com/docs/en/about-claude/pricing","models":{"claude-sonnet-4-6":{"rates":{"input_tokens":"1.50","output_tokens":"7.50","cache_creation_input_tokens":"1.875","cache_creation_1h_input_tokens":"3.00","cache_read_input_tokens":"0.15"}},"claude-sonnet-5":{"rates":{"input_tokens":"1.00","output_tokens":"5.00","cache_creation_input_tokens":"1.25","cache_creation_1h_input_tokens":"2.00","cache_read_input_tokens":"0.10"}}}}
