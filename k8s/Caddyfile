# Media sidecar: /media/<key> -> Garage's internal web endpoint for the bucket,
# the same proxy the Caddy fleet uses for object_storage_paths
# (infra ansible/roles/caddy/templates/static-site.caddy.j2). The bucket is
# never addressed from a browser.
{
	admin off
	auto_https off
	persist_config off
}

:8081 {
	handle_path /media/* {
		reverse_proxy http://garage.rrchnm.internal:3902 {
			header_up Host religiousecologies.org.garage.rrchnm.internal
			header_down Cache-Control "public, max-age=604800"
		}
	}
	respond 404
}
